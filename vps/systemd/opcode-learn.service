[Unit]
Description=OpCode Learn (course site behind nginx: learn.opcode-labs.com)
After=network-online.target
Wants=network-online.target

[Service]
User=learn
Group=learn
EnvironmentFile=/etc/opcode-learn/learn.env
WorkingDirectory=/opt/opcode-learn/app
ExecStart=/opt/opcode-learn/venv/bin/uvicorn learn.web:app --host 127.0.0.1 --port 8095 --no-server-header --no-access-log
Restart=on-failure
RestartSec=5
StateDirectory=opcode-learn
StateDirectoryMode=0700
UMask=0077
MemoryMax=400M

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
